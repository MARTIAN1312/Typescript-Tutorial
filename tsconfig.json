{
  "compilerOptions": {
    // File layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,

    // Strictness (keep this one)
    "strict": true,

    // Quality of life
    "moduleDetection": "force",
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*"]
}